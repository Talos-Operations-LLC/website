---
import Base from '../layouts/Base.astro';
---
<Base title="Coverage — Fee Simple" description="Which North Carolina counties Fee Simple covers today: live in production, or surveyed with bulk data mapped." active="coverage">
<Fragment slot="head">
<link rel="stylesheet" href="/assets/css/coverage.css">
</Fragment>
  <h1 class="headline">coverage, <i>by county</i></h1>
  <div class="counts" id="counts" role="status">Loading coverage…</div>
  <noscript><p>Enable JavaScript to view the interactive coverage map.</p></noscript>

  <div class="map-wrap">
    <svg class="map" id="map" viewBox="0 0 975 610" role="img" aria-label="Map of United States county coverage"></svg>
    <div class="map-controls">
      <button id="zoom-in" aria-label="Zoom in">+</button>
      <button id="zoom-out" aria-label="Zoom out">−</button>
      <button id="zoom-reset" aria-label="Reset view">⌂</button>
    </div>
    <div class="legend">
      <div class="row"><span class="sw live"></span> live — in production</div>
      <div class="row"><span class="sw surveyed"></span> surveyed — bulk data mapped</div>
      <div class="row"><span class="sw none"></span> not yet covered</div>
    </div>
    <div class="tooltip" id="tooltip"></div>
  </div>

  <div class="stats" id="stats"></div>

  <p class="motto">
    <a href="https://www.nationalarchives.gov.uk/education/resources/domesday-book/" target="_blank" rel="noopener noreferrer">"One record, without appeal."</a>
  </p>
<Fragment slot="end">
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.9.0/d3.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/topojson/3.0.2/topojson.min.js"></script>
<script is:inline src="/assets/js/coverage.js"></script>
</Fragment>
</Base>
