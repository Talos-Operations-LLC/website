---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  // Site path ("/learn/x/"); given, it becomes the canonical and og:url.
  path?: string;
  ogType?: 'website' | 'article';
  // The reason a page is held out of search. It is written next to the
  // robots tag so nobody lifts the noindex without knowing why it is there.
  noindex?: string;
  jsonld?: object[];
  active?: 'home' | 'coverage' | 'learn';
}

const { title, description, path, ogType = 'website', noindex, jsonld = [], active } = Astro.props;
const url = path ? new URL(path, Astro.site).href : undefined;
const FONTS = 'https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;600;700&display=swap';
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png">
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
{noindex && <meta name="robots" content="noindex">}
{noindex && <Fragment set:html={`<!-- ${noindex} -->`} />}
{description && <meta name="description" content={description}>}
{url && <link rel="canonical" href={url}>}
<meta property="og:title" content={title}>
{description && <meta property="og:description" content={description}>}
<meta property="og:type" content={ogType}>
{url && <meta property="og:url" content={url}>}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href={FONTS} rel="stylesheet">
{jsonld.map((d) => <script is:inline type="application/ld+json" set:html={JSON.stringify(d, null, 2)} />)}
<slot name="head" />
</head>
<body>
<div class="wrap">
<Nav active={active} />
<slot />
<Footer />
</div>
<slot name="end" />
</body>
</html>
