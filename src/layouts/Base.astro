---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  // Site path ("/learn/x/"); given, it becomes the canonical and og:url.
  path?: string;
  ogType?: 'website' | 'article';
  // The reason a page is held out of search. It is written next to the
  // robots tag so nobody lifts the noindex without knowing why it is there.
  noindex?: string;
  jsonld?: object[];
  active?: 'coverage' | 'learn';
  homeOnly?: boolean;
  // The homepage brings its own header and footer placement; every other
  // marketing page uses the shared navigation and footer below.
  bare?: boolean;
  viewport?: string;
  fontStylesheet?: string;
}

const FONTS = 'https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;450;500;550;600;650;700&display=swap';
const {
  title, description, path, ogType = 'website', noindex, jsonld = [], active,
  bare = false, viewport = 'width=device-width, initial-scale=1.0',
  fontStylesheet = FONTS,
  homeOnly = active === 'coverage' || active === 'learn',
} = Astro.props;
const url = path ? new URL(path, Astro.site).href : undefined;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content={viewport}>
<title>{title}</title>
<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicon-32.png">
<link rel="apple-touch-icon" href="/assets/images/apple-touch-icon.png">
{noindex && <meta name="robots" content="noindex">}
{noindex && <Fragment set:html={`<!-- ${noindex} -->`} />}
{description && <meta name="description" content={description}>}
{url && <link rel="canonical" href={url}>}
<meta property="og:title" content={title}>
{description && <meta property="og:description" content={description}>}
<meta property="og:type" content={ogType}>
{url && <meta property="og:url" content={url}>}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href={fontStylesheet} rel="stylesheet">
{jsonld.map((d) => <script is:inline type="application/ld+json" set:html={JSON.stringify(d, null, 2)} />)}
<link rel="stylesheet" href="/assets/css/site.css">
<slot name="head" />
</head>
<body>
{bare ? <slot /> : (
<div class="wrap">
<Nav active={active} homeOnly={homeOnly} />
<slot />
<Footer full={homeOnly} />
</div>
)}
<slot name="end" />
</body>
</html>
