---
interface Props {
  active?: 'coverage' | 'learn';
  homeOnly?: boolean;
}
const { active, homeOnly = false } = Astro.props;
const links = [
  { key: 'coverage', href: '/coverage.html', label: '[coverage]' },
  { key: 'demo', href: '/demo/', label: '[demo]' },
];
---
<header class="chrome">
  {homeOnly ? <span class="wordmark">Fee Simple<span>.</span></span> : <a class="wordmark" href="/" aria-label="Fee Simple home">Fee Simple<span>.</span></a>}
  <nav class="nav" aria-label="Primary">
    {homeOnly ? <a class="home-link" href="/"><span aria-hidden="true">←</span> Back to home</a> : links.map((l) =>
      l.key === active
        ? <a href={l.href} class="active" aria-current="page">{l.label}</a>
        : <a href={l.href}>{l.label}</a>
    )}
  </nav>
</header>
